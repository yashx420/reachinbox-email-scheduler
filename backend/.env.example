# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5432/reachinbox
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
# Namespace for every BullMQ key, so several environments can share one Redis.
QUEUE_PREFIX=reachinbox

# ---------------------------------------------------------------------------
# Auth (Google OAuth)
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add
# http://localhost:3000 to "Authorised JavaScript origins".
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Throughput / concurrency
# ---------------------------------------------------------------------------
# How many emails a single worker process may have in flight at once.
WORKER_CONCURRENCY=5
# Minimum spacing between two send attempts, enforced by BullMQ's Redis-backed
# limiter (shared by every worker on the queue). 2000ms = max 1 email / 2s.
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# How many sends the limiter allows per MIN_DELAY_BETWEEN_EMAILS_MS window.
RATE_LIMIT_BURST=1
# Run a worker inside the API process (handy in dev). Set false to run
# `npm run dev:worker` as its own process - both modes work simultaneously.
RUN_WORKER_INLINE=true

# ---------------------------------------------------------------------------
# Hourly rate limits (Redis counters, safe across workers/instances)
# Set to 0 to disable a limit.
# ---------------------------------------------------------------------------
MAX_EMAILS_PER_HOUR=500
MAX_EMAILS_PER_HOUR_PER_SENDER=100
# Length of the rate-limit window. Keep 3600000 (1h) in production; drop it to
# 60000 to demo the "hourly" limit in a minute.
RATE_LIMIT_WINDOW_MS=3600000

# ---------------------------------------------------------------------------
# Delivery behaviour
# ---------------------------------------------------------------------------
EMAIL_MAX_ATTEMPTS=3
EMAIL_BACKOFF_MS=5000
# Maximum recipients accepted in a single schedule request.
MAX_RECIPIENTS_PER_CAMPAIGN=10000
# On boot, re-add any DB job that is missing from Redis and release jobs that
# were stuck mid-send when the process died.
RECONCILE_ON_BOOT=true
STALE_PROCESSING_MS=120000

# ---------------------------------------------------------------------------
# Ethereal / SMTP
# `npm run senders:create` provisions this many throwaway Ethereal mailboxes.
# ---------------------------------------------------------------------------
ETHEREAL_SENDER_COUNT=3
# Optional: bring your own SMTP accounts instead, as a JSON array.
# SMTP_ACCOUNTS=[{"label":"sender-1","host":"smtp.ethereal.email","port":587,"user":"x@ethereal.email","pass":"secret","fromName":"ReachInbox"}]
